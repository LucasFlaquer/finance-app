# Copy this file to `.env`. The defaults match the local docker-compose.yml database.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 17.

DATABASE_URL="postgresql://docker:docker@localhost:5432/finance?schema=public"

# Dedicated database for Playwright E2E. The name must end with "_e2e".
# Created and migrated automatically by `pnpm test:e2e`.
E2E_DATABASE_URL="postgresql://docker:docker@localhost:5432/finance_e2e?schema=public"
